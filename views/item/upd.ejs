<%- include('../cabecalho')%>

        <a href="/item"> ← Voltar </a>
        <h3>Alterar Item</h3>

        <form method="post">
            <p>ID</p>
            <input type="text" name="id" value="<%= item.id %>" readonly>
            <br><br>

            <p>Nome do Item</p>
            <input type="text" name="nome" value="<%= item.nome %>" required>
            <br><br>

            <p>Estação</p>
            <select name="estacao" value="<%= item.estacao %>">
                <option value="Primavera">Primavera</option>
                <option value="Verão">Verão</option>
                <option value="Outono">Outono</option>
                <option value="Inverno">Inverno</option>
                <option value="Todas">Todas as Estações</option>
            </select>
            <br><br>

            <p>Onde Encontrar</p>
            <input type="text" name="encontrar" value="<%= item.encontrar %>">
            <br><br>

            <p>Dificuldade</p>
            <select name="dificuldade" value="<%= item.dificuldade %>">
                <option value="Fácil">Fácil</option>
                <option value="Média">Média</option>
                <option value="Difícil">Difícil</option>
            </select>

            <br><br>
            <button type="submit">Salvar Alterações</button>
            <button type="reset">Cancelar</button>
        </form>
    </div>

</body>
</html>