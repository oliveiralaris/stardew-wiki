<%- include('../cabecalho')%>


    <div>
        <tr><a href="../npc"> ← Voltar </a></tr>
        <h3>Novo Npc</h3>


        <form method="post">
            <p>Nome</p>
            <input name="nome" type="text" placeholder="Nome do Npc">
            <br>
            <p>Aniversário</p>
            <input name="aniversario" type="text" placeholder="Data de Aniversário">
            <br>
            <p>Presente</p>
            <input name="presente" type="text" placeholder="Presente amado do Npc">
            <br>
            <p>Dica</p>
            <input name="dica" type="text" placeholder="Dica sobre o Npc">
            <br><br>
            <button type="submit">Adicionar</button>
            <button type="reset">Cancelar</button>
        </form>
    </div>
    </body>

    </html>