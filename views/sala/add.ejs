<%- include('../cabecalho')%>


    <div>
        <tr><a href="../sala"> ← Voltar </a></tr>
        <h3>Nova sala</h3>


        <form method="post">
            <p>Nome</p>
            <input name="nome" type="text" placeholder="Nome da sala">
            <br>
            <p>Recompensa</p>
            <input name="recompensa" type="text" placeholder="Recompensa da sala">
            <br>
            <p>Dica</p>
            <input name="dica" type="text" placeholder="Dica sobre a sala">
            <br><br>
            <button type="submit">Adicionar</button>
            <button type="reset">Cancelar</button>
        </form>
    </div>
    </body>

    </html>